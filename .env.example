# Address players type into their client: a public hostname or IP.
# The char and map servers hand this to the client, so it must be
# reachable from wherever players connect.
PUBLIC_HOST=ro.example.com

# Generate with e.g. `openssl rand -hex 10`. INTER_PASSWORD must be 23 characters or fewer.
DB_PASSWORD=
INTER_PASSWORD=

# Registration: players create an account by logging in as name_M or name_F
# with the password they want. Set false to create accounts yourself.
NEW_ACCOUNT=true

# Compile-time, must match the client: rebuild after changing.
# Client date (YYYYMMDD) of the client players run, e.g. 20190530.
PACKETVER=20190530
# ON = Renewal mechanics, OFF = pre-renewal (classic).
RENEWAL=ON
# HERCULES_REF=v2026.09
